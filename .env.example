# このファイルを .env.local という名前でコピーし、値を入れてください。
# .env.local はGitに含まれません。値をREADMEやIssueに貼らないでください。

# SupabaseのProject URL（Project Settings → Data API）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# SupabaseのSecret key、またはLegacy API Keysのservice_role key。
# サーバー専用です。anon / Publishable keyを入れると動きません。
SUPABASE_SERVICE_ROLE_KEY=

# ログイン画面で入力するパスワード。推測されにくいものにしてください。
AUTH_PASSWORD=

# --- ここから下は任意 ---

# Google AI StudioのAPIキー。企業リサーチ機能を使う場合だけ必要です。
GEMINI_API_KEY=

# ログイン状態の署名鍵。未設定ならAUTH_PASSWORDを使います。
# 作り方: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# PostgreSQLの接続文字列（SupabaseのConnect → Session pooler）。設定すると、
# npm run build のときにデータベースを自動で作成・更新します。
POSTGRES_URL_NON_POOLING=

# 卒業年度の下2桁。「28卒マイページ」などの表示に使います。未設定なら28。
NEXT_PUBLIC_GRADUATION_YEAR=28
